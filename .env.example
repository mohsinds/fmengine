# fmengine / fmtrader — environment configuration
#
# Copy this file to `.env` and fill in real values before running `make up`.
# `.env` is gitignored — never commit it. This file (.env.example) is the only one that
# belongs in version control.
#
# docker-compose.yml now uses the `${VAR:?message}` syntax for every credential below marked
# REQUIRED. That means `make up` / `docker compose up` will refuse to start and print an error
# naming the missing variable if you skip this step — it will not silently fall back to a weak
# default. If you see one of those errors, it means this file wasn't copied to `.env`, or a
# variable in it was left blank.

# ---------------------------------------------------------------------------
# REQUIRED — infrastructure credentials
# ---------------------------------------------------------------------------
# Pick real values here, not the words "user" or "password". These protect QuestDB and Postgres,
# which hold your trial registry, journal, and cost ledger. Even for local-only development,
# do not reuse a password you use anywhere else — generate one:
#   openssl rand -base64 24

QUESTDB_USER=
QUESTDB_PASSWORD=

POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# REQUIRED once Phase 7 (agentic pipeline) is built — frontier LLM API keys
# ---------------------------------------------------------------------------
# Used only for Tier 2 gating decisions (never in the live order path — see SCOPE.md §9).
# Leave blank until Phase 7; the budget governor treats a missing key as "provider unavailable"
# and degrades to the local Ollama tier rather than crashing.
# Scope these keys to the minimum they need and set spend alerts on the provider side in addition
# to the in-app budget governor — the governor is a safety net, not your only control.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama (local Metal + optional Cloud)
# OLLAMA_URL=http://localhost:11434
# Cloud models (e.g. kimi-k2.6) use the same host once signed in (`ollama signin`).
# OLLAMA_CLOUD_URL defaults to Ollama local URL; set OLLAMA_API_KEY if your install requires it.
OLLAMA_URL=http://localhost:11434
OLLAMA_CLOUD_URL=http://localhost:11434
OLLAMA_API_KEY=

# Optional LangSmith tracing for agent/LLM spans (project name FMEngine).
# Never commit real keys — rotate if pasted in chat.
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=FMEngine
LANGSMITH_TRACING=false

# Large-model research profile (gpt-oss:20b / qwen3.8:27b) needs more than the
# default 8 GB Ollama ceiling — raise MEMORY_BUDGET_OLLAMA_GB (e.g. 18) and
# lower campaign workers while those models run. Do not co-load 20B+27B.
# MEMORY_BUDGET_OLLAMA_GB=8

# ---------------------------------------------------------------------------
# REQUIRED once Phase 7 is built — LLM budget governor caps (USD)
# ---------------------------------------------------------------------------
# See SCOPE.md open question 2. Set real numbers before the first campaign runs — the governor
# refuses calls that would breach these, so an unset or zero value effectively disables Tier 2
# spend entirely (which is a safe, valid default — it just means every call falls back to local).

LLM_BUDGET_PER_CAMPAIGN_USD=0
LLM_BUDGET_PER_DAY_USD=0
LLM_BUDGET_PER_GENERATION_USD=0

# ---------------------------------------------------------------------------
# OPTIONAL — GitHub access, if your tooling needs it (e.g. Cursor's GitHub integration)
# ---------------------------------------------------------------------------

GITHUB_PAT=

# ---------------------------------------------------------------------------
# DEFERRED — Phase 9 (CME futures). Leave blank until you start that phase.
# ---------------------------------------------------------------------------

DATABENTO_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Phase 10 (execution & brokers). Blank = in-process paper sim.
# TWS paper port is typically 7497; IB Gateway paper 4002.
# ---------------------------------------------------------------------------

IBKR_ACCOUNT_ID=
IBKR_PAPER_ACCOUNT_ID=
IBKR_GATEWAY_HOST=
IBKR_GATEWAY_PORT=

# ---------------------------------------------------------------------------
# OPTIONAL — news/sentiment. Prefer NEWS_API_KEY; if blank, news_feed provider
# tries free RSS and disables cleanly if that fails too.
# ---------------------------------------------------------------------------

NEWS_API_KEY=

# ---------------------------------------------------------------------------
# DEFERRED — equities-phase fundamentals vendor (open question 8 in SCOPE.md).
# ---------------------------------------------------------------------------

FUNDAMENTALS_API_KEY=
