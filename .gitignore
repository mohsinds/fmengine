# Secrets — never commit real credentials
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
uv.lock.bak

# Data & artifacts — large, regenerable, or environment-specific
data/raw/*
!data/raw/.gitkeep
data/catalog/*
!data/catalog/.gitkeep
data/nautilus/*
!data/nautilus/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep
data/features/*
!data/features/.gitkeep
data/executions/*
!data/executions/.gitkeep
data/registry/*
!data/registry/.gitkeep
data/holdout/*
!data/holdout/.gitkeep
data/campaigns/*
!data/campaigns/.gitkeep
data/journals/*
!data/journals/.gitkeep
data/ledger/*
!data/ledger/.gitkeep
artifacts/*
!artifacts/.gitkeep
download/*.csv
download/*.parquet
*.db
*.duckdb

# Docker volumes mounted locally (if any escape the named-volume pattern)
docker-data/

# Node / Next.js (frontend)
node_modules/
.next/
out/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Logs and local run artifacts
*.log
mlruns/
.cursor/logs/
.cursor/mcp.local.json
