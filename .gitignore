# Secrets — never commit real credentials
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Data — large, regenerable, or environment-specific
data/catalog/
data/snapshots/*.json
download/*.csv
download/*.parquet
*.db
*.duckdb

# Docker volumes mounted locally (if any escape the named-volume pattern)
docker-data/

# Node / Next.js (frontend)
node_modules/
.next/
out/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Logs and local run artifacts
*.log
mlruns/
.cursor/logs/